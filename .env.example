# Browser configuration only. Every VITE_* value is public in the built bundle.
# Never put private keys, provider secrets, JWTs, or AI API keys in this file.

# Runtime mode
VITE_NETWORK_MODE=mainnet
VITE_BACKEND_URL=
VITE_BACKEND_API_URL=

# Mainnet RPC endpoints
VITE_ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
VITE_OPTIMISM_MAINNET_RPC_URL=https://mainnet.optimism.io
VITE_ETHEREUM_MAINNET_RPC_URL=https://cloudflare-eth.com
VITE_XDC_MAINNET_RPC_URL=https://erpc.xinfin.network

# Keep false until XDC LOWJC V3, Local Bridge V2, NOWJC V5, and Native Bridge V2 are live and configured.
VITE_XDC_APPLICANT_MILESTONES_ENABLED=false

# Arbitrum write adapters. These are deliberately not NOWJC/NativeAthena.
VITE_NATIVE_ARB_LOWJC_ADDRESS=0x5727cA7326032a8644a49dECECB8388BEF122bef
VITE_NATIVE_ARB_ATHENA_ADDRESS=0xB5d3F406089236ef9d4aB13306187aFCCA81f099

# Optional testnet RPC endpoints when VITE_NETWORK_MODE=testnet
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
VITE_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Legacy pages still consume these public read addresses in testnet mode.
VITE_GENESIS_CONTRACT_ADDRESS=0x00Fad82208A77232510cE16CBB63c475A914C95a
VITE_NOWJC_CONTRACT_ADDRESS=0x39158a9F92faB84561205B05223929eFF131455e
VITE_PROFILE_GENESIS_ADDRESS=0x45468344678D2Af5353fb4b5E825A21b186Fa57a

# LayerZero execution options used by cross-chain local adapters
VITE_LAYERZERO_OPTIONS_VALUE=0x000301001101000000000000000000000000000F4240
