# OpenWork CCTP Backend Configuration

# Runtime mode
NETWORK_MODE=mainnet
PORT=3001
LOG_LEVEL=info

# Browser origins allowed to call this service (comma-separated)
ALLOWED_ORIGINS=https://app.openwork.technology,http://localhost:5173

# Operator-only endpoints. Generate independent, high-entropy values.
OPS_API_TOKEN=replace_with_a_long_random_operator_token
HEALTH_SECRET=replace_with_a_long_random_health_token
ENABLE_MAINNET_TEST_ROUTES=false

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password

# JWT Secret (for session tokens) - Use a strong random string in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Session expiry (in hours)
SESSION_EXPIRY_HOURS=24

# RPC URLs
OPTIMISM_MAINNET_RPC_URL=https://mainnet.optimism.io
ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
XDC_MAINNET_RPC_URL=https://rpc.xdc.network
OPTIMISM_SEPOLIA_RPC_URL=https://optimism-sepolia.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia.infura.io/v3/YOUR_INFURA_KEY

# Service Wallet (WALL2) - Private key WITHOUT 0x prefix
WALL2_PRIVATE_KEY=your_private_key_here

# Only used by the disabled mainnet smoke route
TAKER_PRIVATE_KEY=your_test_taker_private_key_here

# IPFS uploads (configure at least one strategy)
LIGHTHOUSE_API_KEY=
PINATA_JWT=
IPFS_API_URL=
IPFS_PROXY_SECRET=

# Agent Oppy — uses the AWS SDK default credential chain / App Runner instance role
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MAX_TOKENS=1400
CHAT_REQUESTS_PER_MINUTE=12
CHAT_MAX_CONCURRENT_REQUESTS=20

# PostgreSQL Database Configuration
# For Cloud Run (Unix socket to Cloud SQL):
#   DB_HOST=/cloudsql/openwork-480320:us-central1:openwork-db
# For local development (TCP):
#   DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openwork
DB_USER=postgres
DB_PASSWORD=postgres

# Polling Configuration (in milliseconds)
EVENT_POLL_INTERVAL=3000
CCTP_POLL_INTERVAL=10000
MAX_RETRY_ATTEMPTS=20

# Timeouts (in milliseconds)
EVENT_DETECTION_TIMEOUT=300000
CCTP_ATTESTATION_TIMEOUT=300000

# ── IPFS upload protection ───────────────────────────────────────────────────
# Turn on only after every upload path is confirmed to send wallet-signature
# headers. While false, valid signatures are still honoured and metered.
IPFS_REQUIRE_SIGNATURE=false
# Daily upload budget per wallet address.
IPFS_DAILY_BYTES_PER_ADDRESS=52428800
# Addresses exempt from the normal budget, comma separated.
IPFS_UPLOAD_ALLOWLIST=0x7a2B7feAB9b0e30A5368d3CC4CB8279c9606384C
IPFS_ALLOWLIST_DAILY_BYTES=5368709120
# Refuse uploads once the Kubo repo passes this fraction of its cap.
IPFS_DISK_STOP_FRACTION=0.85

# ── Relay endpoint protection ────────────────────────────────────────────────
# Turn on once the frontend sends wallet-signature headers on relay calls.
RELAY_REQUIRE_SIGNATURE=false
# Ceiling on concurrent background relay watchers.
MAX_CONCURRENT_RELAY_FLOWS=50
